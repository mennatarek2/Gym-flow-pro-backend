{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=5000"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "GymFlowPro.API",
    "Audience": "GymFlowPro.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "PlatformJwt": {
    "Audience": "gymflow-platform",
    "AccessTokenExpirationMinutes": 10,
    "Description": "Platform tokens use JwtSettings Issuer/SecretKey but Audience=gymflow-platform (see PlatformAuthConstants)."
  },
  "PlatformSeed": {
    "Email": "admin@gymflow.local",
    "Password": "",
    "FullName": "Platform Admin"
  },
  "PlatformSubscription": {
    "TrialDays": 14
  },
  "PlatformBilling": {
    "DueDays": 7,
    "VatRate": 0.0,
    "WhatsAppOverageEgpPerMessage": 0.35,
    "DunningGraceDaysAfterPastDue": 5,
    "SuspensionCheckinBufferHours": 72,
    "LegalName": "GymFlow",
    "LegalNameAr": "جيم فلو",
    "Code": "GYMFLOW",
    "InstapayBaseUrl": "https://instapay.example/pay",
    "TaxRegistrationNumber": "",
    "FooterText": "GymFlow platform billing invoice.",
    "FooterTextAr": "فاتورة فوترة منصة GymFlow."
  },
  "PlatformHealth": {
    "Weights": {
      "LoginFrequency": 0.20,
      "FeatureBreadth": 0.15,
      "PaymentHealth": 0.25,
      "MemberBaseTrend": 0.20,
      "SupportTicketVolume": 0.05,
      "UsageVsCap": 0.15
    },
    "Bands": {
      "HealthyMin": 75,
      "WatchMin": 50,
      "AtRiskMin": 25
    },
    "Notes": "Rules-based starting weights (no ML). Tune against real churn once volume exists. SupportTicketVolume is stubbed unavailable until a support tool lands."
  },
  "PlatformPaymob": {
    "ApiKey": "",
    "HmacSecret": ""
  },
  "PlatformFawry": {
    "MerchantCode": "",
    "SecurityKey": ""
  },
  "SignalR": {
    "RedisChannelPrefix": "GymFlowPro",
    "EnableRedisBackplane": false
  },
  "DatabaseConfig": {
    "Provider": "LocalDB",
    "Description": "Local SQL Server LocalDB - Perfect for development"
  },
  "AppSettings": {
    "ApplicationName": "GymFlow Pro",
    "Version": "3.0.0",
    "Environment": "Development"
  },
  "OtpDelivery": {
    "Provider": "email",
    "OtpTtlMinutes": 5,
    "OtpLength": 6
