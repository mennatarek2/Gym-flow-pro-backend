{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "Caching": {
    "UseRedis": false
  },
  "Hangfire": {
    "WorkerCount": 1
  },
  "Hosting": {
    "ServeWebDashboard": true
  },
  "DatabaseConfig": {
    "Provider": "SqlServer",
    "ApplyMigrationsOnStartup": true,
    "Description": "MonsterASP Cloud SQL — set connection string in hosting panel env vars"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "JwtSettings": {
    "Issuer": "GymFlowPro.API",
    "Audience": "GymFlowPro.Clients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "PlatformSeed": {
    "Email": "",
    "Password": "",
    "FullName": "Platform Admin"
  },
  "SignalR": {
    "EnableRedisBackplane": false
  },
  "OtpDelivery": {
    "Provider": "email"
  },
  "EmailSettings": {
    "Provider": "smtp",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "FromName": "GymFlowPro"
  },
  "AppSettings": {
    "ApplicationName": "GymFlow Pro",
    "Version": "3.0.0",
    "Environment": "Production"
  }
}
