<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>HyMotionLauncher</AssemblyName>
    <!-- No console window on normal operation (Phase 3 "Desktop Experience" requirement) -->
    <ApplicationIcon>hymotion.ico</ApplicationIcon>
    <!-- Phase 3.1: self-contained WinForms publish otherwise drags in ~100MB of localized
         resource DLLs (es/fr/de/ja/ko/...) for what is just a MessageBox on the failure path. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

</Project>
