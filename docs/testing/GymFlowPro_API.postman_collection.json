        {
          "name": "Assign Membership",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('✅ Membership assigned');",
                  "    console.log('Status:', jsonData.status);",
                  "    console.log('Start Date:', jsonData.startDate);",
                  "    console.log('End Date:', jsonData.endDate);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{TOKEN}}",
                  "type": "string"
                }
