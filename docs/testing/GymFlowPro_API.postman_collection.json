        },
        {
          "name": "Renew Membership",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    console.log('✅ Membership renewed');",
                  "    console.log('New Start Date:', jsonData.startDate);",
                  "    console.log('New End Date:', jsonData.endDate);",
                  "    console.log('(Continuous timeline - no gap between memberships)');",
                  "}"
                ]
