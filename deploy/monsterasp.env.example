# MonsterASP environment variables (set in hosting panel — do not commit real values)
# Copy keys to MonsterASP → Website → Environment variables

ASPNETCORE_ENVIRONMENT=Production

# Cloud SQL from MonsterASP → Databases
# If the password contains # ; or @, wrap it in double quotes: Password="your#pass";
ConnectionStrings__DefaultConnection=Server=db64550.databaseasp.net;Database=db64550;User Id=db64550;Password="YOUR_PASSWORD";Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True

# Required — generate new secrets for production (64+ characters)
JwtSettings__SecretKey=
EncryptionKey=

# Member App activation pepper (random string, 16+ characters)
MemberAppActivation__CodePepper=

# SMTP (Premium plan — outbound mail)
EmailSettings__SmtpHost=smtp.your-provider.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=
EmailSettings__SmtpPassword=
EmailSettings__FromAddress=
EmailSettings__FromName=GymFlowPro

# Optional — first platform admin (leave empty to skip auto-seed)
PlatformSeed__Email=
PlatformSeed__Password=

# Optional — Flutter member app / extra web origins (comma-separated in JSON array via panel)
# Cors__AllowedOrigins__0=https://app.yourdomain.com

Caching__UseRedis=false
Hangfire__WorkerCount=1
DatabaseConfig__ApplyMigrationsOnStartup=true
Hosting__ServeWebDashboard=true
